# Obtain these at https://my.telegram.org/apps (your application's credentials).
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_your_api_hash
# Create the bot through @BotFather. Never paste this token into a public chat.
BOT_TOKEN=123456789:replace_with_your_bot_token
# Comma-separated numeric USER IDs, not usernames or phone numbers.
ALLOWED_USER_IDS=123456789,987654321

# Compose overrides these paths/URL for its containers.
DATA_DIR=./data
BOT_API_BASE_URL=http://127.0.0.1:8081
MAX_FILE_BYTES=2000000000
MAX_PENDING_PER_USER=5
MIN_FREE_DISK_BYTES=67108864
TRANSFER_TIMEOUT_SECONDS=7200
PROGRESS_INTERVAL_SECONDS=5

# Local Bot API image, maintained by the aiogram project. Pin a digest for deployment.
BOT_API_IMAGE=aiogram/telegram-bot-api:latest

# Optional for Heroku: set through Heroku Config Vars, not in an image.
# DATABASE_URL is supplied by Heroku Postgres.
# DATABASE_URL=postgresql://...
# TELEGRAM_SESSION=the_string_from_export-session
